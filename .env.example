# CodeSentinel Environment Configuration

# Core Application
APP_NAME=CodeSentinel
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# GitHub Webhook & API Integration
# Create personal access token with 'repo' scope at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_sample_token_for_testing
# Secret configured in repo Webhook settings (Payload URL: https://<domain>/webhook/github)
GITHUB_WEBHOOK_SECRET=sample_sentinel_webhook_secret_key_123

# Redis Task Queue (ARQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# LLM Providers (Required in Phase 2)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Observability & Tracing (LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=codesentinel
